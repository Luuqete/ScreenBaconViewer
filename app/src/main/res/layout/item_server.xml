<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#2A3740"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Indicador visual de estado -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#D9738E"
            android:layout_marginEnd="16dp" />

        <!-- Información del Servidor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2F2F2"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D9738E"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvSessionId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2F2F2"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Botones de Conexión según interfaz -->
        <LinearLayout
            android:id="@+id/layoutConnectButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Botón Wi-Fi (Rosado/Detalles) -->
            <Button
                android:id="@+id/btnConnectWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi"
                android:textAllCaps="false"
                android:backgroundTint="#D9738E"
                android:textColor="#F2F2F2"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <!-- Botón Cable USB / Ethernet (Verde/Background para contrastar con la card) -->
            <Button
                android:id="@+id/btnConnectEthernet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cable USB"
                android:textAllCaps="false"
                android:backgroundTint="#24956B"
                android:textColor="#F2F2F2"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:visibility="gone" />

            <!-- Botón Genérico si solo hay una interfaz o genérica -->
            <Button
                android:id="@+id/btnConnectGeneric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conectar"
                android:textAllCaps="false"
                android:backgroundTint="#D9738E"
                android:textColor="#F2F2F2"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>